[{"t0": 3.9, "t1": 5.845, "text": "元丰五年，三月初七"}, {"t0": 5.895, "t1": 10.235, "text": "黄州城外的沙湖道上，下起了一场大雨"}, {"t0": 11.485, "t1": 16.392, "text": "雨具早被人先带走了，同行的人四散奔逃，狼狈不堪"}, {"t0": 16.642, "t1": 19.514, "text": "只有一个人，拄着竹杖，穿着草鞋"}, {"t0": 19.564, "t1": 21.712, "text": "不紧不慢地往前走"}, {"t0": 23.162, "t1": 24.403, "text": "后来他写道"}, {"t0": 24.453, "t1": 29.15, "text": "莫听穿林打叶声，何妨吟啸且徐行"}, {"t0": 29.2, "t1": 32.202, "text": "竹杖芒鞋轻胜马，谁怕？"}, {"t0": 32.252, "t1": 34.975, "text": "一蓑烟雨任平生"}, {"t0": 37.425, "t1": 39.297, "text": "很多人记住了这份从容"}, {"t0": 39.647, "t1": 41.388, "text": "可很少有人注意到"}, {"t0": 41.438, "t1": 44.298, "text": "也是这一年的春天，寒食节前后"}, {"t0": 44.348, "t1": 47.384, "text": "他写下了一生中最绝望的诗"}, {"t0": 57.734, "t1": 61.743, "text": "三年前，苏轼四十三岁，文名满天下"}, {"t0": 61.993, "t1": 63.166, "text": "一场“乌台诗案”"}, {"t0": 63.216, "t1": 67.845, "text": "他因为几首诗被抓进御史台的大牢，关了四个多月"}, {"t0": 68.095, "t1": 71.178, "text": "最难熬的时候，他以为自己活不成了"}, {"t0": 71.228, "t1": 73.875, "text": "给弟弟苏辙写下了诀别诗"}, {"t0": 75.725, "t1": 78.01, "text": "出狱以后，他被贬到黄州"}, {"t0": 78.06, "t1": 80.344, "text": "挂了个“团练副使”的名头"}, {"t0": 80.394, "t1": 83.546, "text": "不许签署公事，不许擅离此地"}, {"t0": 83.796, "t1": 87.28, "text": "说是官，其实是一个被看管起来的罪人"}, {"t0": 89.33, "t1": 93.521, "text": "初到黄州，他寄住在一座寺院里，闭门不出"}, {"t0": 93.771, "t1": 97.918, "text": "后来他在信里说，平生的亲友，没有一个字寄来"}, {"t0": 97.968, "t1": 100.527, "text": "他写信过去，人家也不回"}, {"t0": 101.977, "t1": 105.574, "text": "那段日子，他把自己写成了一只孤鸿"}, {"t0": 105.924, "t1": 109.413, "text": "拣尽寒枝不肯栖，寂寞沙洲冷"}, {"t0": 112.863, "t1": 114.446, "text": "我们总说苏轼豁达"}, {"t0": 114.496, "t1": 119.338, "text": "可豁达不是天生的性格，更不是一直挂在脸上的表情"}, {"t0": 119.588, "t1": 123.654, "text": "到黄州的第三个寒食节，雨已经下了两个多月"}, {"t0": 123.904, "t1": 127.308, "text": "他住的小屋，像一条漂在水云里的渔船"}, {"t0": 127.558, "t1": 132.879, "text": "厨房空空的，锅里煮的是寒菜，破灶里烧的是湿芦苇"}, {"t0": 133.129, "t1": 137.96, "text": "看见乌鸦衔着纸钱飞过，他才想起来：今天是寒食"}, {"t0": 139.41, "t1": 142.95, "text": "君门深九重，坟墓在万里"}, {"t0": 143.3, "t1": 144.92, "text": "想回朝廷，回不去"}, {"t0": 144.97, "t1": 148.9, "text": "想回眉山老家给父母扫墓，也回不去"}, {"t0": 149.25, "t1": 150.828, "text": "最后两句是"}, {"t0": 150.878, "t1": 153.946, "text": "也拟哭途穷，死灰吹不起"}, {"t0": 154.296, "t1": 157.466, "text": "想学阮籍，走到路的尽头痛哭一场"}, {"t0": 157.516, "t1": 162.007, "text": "可是心已经像一堆死灰，连吹都吹不起来了"}, {"t0": 162.357, "t1": 163.943, "text": "这两首诗的手稿"}, {"t0": 163.993, "t1": 168.317, "text": "就是后来被称作“天下第三行书”的《寒食帖》"}, {"t0": 173.367, "t1": 177.452, "text": "所以，这一期想说的第一件事是：不被情绪吞掉"}, {"t0": 177.502, "t1": 179.376, "text": "不等于没有情绪"}, {"t0": 179.826, "t1": 182.677, "text": "苏轼也跌到过谷底。区别只在于"}, {"t0": 182.727, "t1": 185.086, "text": "他没有在谷底住下来"}, {"t0": 185.536, "t1": 187.814, "text": "那他是怎么一步一步走出来的？"}, {"t0": 187.864, "t1": 190.362, "text": "我们看他在黄州做的三件事"}, {"t0": 192.212, "t1": 194.822, "text": "第一件：把情绪交给纸"}, {"t0": 195.072, "t1": 197.182, "text": "他没有假装自己没事"}, {"t0": 197.232, "t1": 198.863, "text": "孤鸿、死灰、哭途穷"}, {"t0": 198.913, "t1": 201.663, "text": "他都老老实实写了下来"}, {"t0": 201.913, "t1": 205.327, "text": "心理学家彭尼贝克做过很多年的研究"}, {"t0": 205.377, "t1": 209.657, "text": "把痛苦的经历和真实的感受写下来，连续写几天"}, {"t0": 209.707, "t1": 211.389, "text": "每次十几二十分钟"}, {"t0": 211.439, "t1": 215.469, "text": "很多人的情绪和身体状态都会慢慢好转"}, {"t0": 215.719, "t1": 219.737, "text": "关键不在于写得多漂亮，而在于给情绪一个名字"}, {"t0": 219.787, "t1": 221.15, "text": "一个形状"}, {"t0": 221.2, "t1": 223.636, "text": "情绪一旦落到纸上，它就从“我”"}, {"t0": 223.686, "t1": 225.915, "text": "变成了“我面前的一样东西”"}, {"t0": 225.965, "t1": 229.009, "text": "你可以看着它，而不是被它淹没"}, {"t0": 230.459, "t1": 232.918, "text": "苏轼还常去城南的安国寺"}, {"t0": 232.968, "t1": 237.88, "text": "他说自己隔一两天就去一次，“焚香默坐，深自省察”"}, {"t0": 238.13, "t1": 242.374, "text": "今天我们也许会把它叫作“觉察”：看着念头升起来"}, {"t0": 242.424, "t1": 243.877, "text": "再看着它落下去"}, {"t0": 243.927, "t1": 246.853, "text": "不急着赶走它，也不跟着它跑"}, {"t0": 248.903, "t1": 251.523, "text": "第二件：让身体先动起来"}, {"t0": 251.773, "t1": 255.027, "text": "到黄州的第二年，日子越来越窘迫"}, {"t0": 255.277, "t1": 259.349, "text": "他想了个办法：每月初一取出四千五百文钱"}, {"t0": 259.399, "t1": 261.64, "text": "分成三十串，挂在房梁上"}, {"t0": 261.69, "t1": 265.762, "text": "每天早上用画叉挑下一串，就是一天的用度"}, {"t0": 265.812, "t1": 267.994, "text": "然后把画叉藏起来"}, {"t0": 269.444, "t1": 272.372, "text": "老朋友马正卿看他快吃不上饭了"}, {"t0": 272.422, "t1": 276.838, "text": "替他向官府讨来城东一片废弃的营地，几十亩坡地"}, {"t0": 276.888, "t1": 278.688, "text": "满是荆棘瓦砾"}, {"t0": 278.764, "t1": 283.281, "text": "苏轼带着家人开荒、种麦、种稻，又栽了桑枣"}, {"t0": 283.531, "t1": 286.836, "text": "他给这片坡地起了个名字，叫“东坡”"}, {"t0": 286.886, "t1": 290.111, "text": "也给自己起了个号：东坡居士"}, {"t0": 290.361, "t1": 295.222, "text": "他还琢磨起黄州便宜的猪肉：少放水，小火慢炖"}, {"t0": 295.272, "t1": 299.24, "text": "“待他自熟莫催他，火候足时他自美。”"}, {"t0": 300.89, "t1": 304.664, "text": "心理学里有一种帮助走出抑郁的方法"}, {"t0": 304.714, "t1": 307.532, "text": "叫“行为激活”：心情低落的时候"}, {"t0": 307.582, "t1": 312.313, "text": "不要等心情好了才去做事，而是先去做一些小的"}, {"t0": 312.363, "t1": 315.103, "text": "具体的、自己能掌控的事"}, {"t0": 315.353, "t1": 318.608, "text": "心情，常常是跟在行动后面回来的"}, {"t0": 318.858, "t1": 322.985, "text": "开荒、种麦、数着铜钱过日子、炖一锅肉"}, {"t0": 323.035, "t1": 324.656, "text": "这些事都很小"}, {"t0": 324.706, "t1": 329.669, "text": "但每一件都在告诉他：我的生活，还有一部分"}, {"t0": 329.719, "t1": 332.297, "text": "是我自己能动手的"}, {"t0": 334.747, "t1": 337.268, "text": "第三件：换一个距离看"}, {"t0": 337.518, "t1": 340.698, "text": "元丰五年七月十六，月亮正圆"}, {"t0": 340.748, "t1": 343.658, "text": "苏轼和朋友泛舟赤壁之下"}, {"t0": 343.708, "t1": 346.211, "text": "清风徐来，水波不兴"}, {"t0": 346.461, "t1": 352.873, "text": "有位客人吹起洞箫，箫声呜呜咽咽，如怨如慕，如泣如诉"}, {"t0": 353.123, "t1": 357.59, "text": "客人说：哀吾生之须臾，羡长江之无穷"}, {"t0": 357.64, "t1": 362.809, "text": "人这一生太短了，真羡慕长江没有尽头"}, {"t0": 363.059, "t1": 366.231, "text": "很多人读到这里会觉得，这位悲伤的客人"}, {"t0": 366.281, "t1": 368.905, "text": "很像苏轼心里的另一个声音"}, {"t0": 369.155, "t1": 372.813, "text": "他没有把这个声音压下去，而是让它把话说完"}, {"t0": 372.863, "t1": 374.774, "text": "然后平静地回答它"}, {"t0": 376.024, "t1": 378.31, "text": "客亦知夫水与月乎？"}, {"t0": 378.36, "t1": 380.937, "text": "逝者如斯，而未尝往也"}, {"t0": 380.987, "t1": 384.549, "text": "盈虚者如彼，而卒莫消长也"}, {"t0": 384.999, "t1": 390.024, "text": "盖将自其变者而观之，则天地曾不能以一瞬"}, {"t0": 390.074, "t1": 396.345, "text": "自其不变者而观之，则物与我皆无尽也，而又何羡乎！"}, {"t0": 398.195, "t1": 401.65, "text": "心理学家伊森·克罗斯研究过一种方法"}, {"t0": 401.7, "t1": 405.156, "text": "叫“自我抽离”：像一个旁观者那样看自己"}, {"t0": 405.206, "t1": 409.1, "text": "比如用自己的名字、用第三人称跟自己说话"}, {"t0": 409.15, "t1": 413.005, "text": "同样的困境，带来的情绪冲击会小很多"}, {"t0": 413.255, "t1": 414.431, "text": "苏轼走得更远"}, {"t0": 414.481, "t1": 418.51, "text": "他把镜头一直拉远，拉到江水和明月的尺度"}, {"t0": 418.76, "t1": 421.812, "text": "在这个尺度上，一次贬谪依然是痛的"}, {"t0": 421.862, "t1": 423.662, "text": "但它不再是全部"}, {"t0": 423.909, "t1": 429.475, "text": "惟江上之清风，与山间之明月，耳得之而为声"}, {"t0": 429.525, "t1": 434.243, "text": "目遇之而成色，取之无禁，用之不竭"}, {"t0": 434.493, "t1": 438.688, "text": "官职可以被拿走，可清风明月，没有人拿得走"}, {"t0": 440.738, "t1": 442.695, "text": "客喜而笑，洗盏更酌"}, {"t0": 442.745, "t1": 448.364, "text": "那一夜，他们横七竖八地睡在船上，不知东方之既白"}, {"t0": 451.014, "t1": 453.971, "text": "现在，再回头看那场雨"}, {"t0": 454.321, "t1": 459.006, "text": "料峭春风吹酒醒，微冷，山头斜照却相迎"}, {"t0": 459.056, "t1": 464.141, "text": "回首向来萧瑟处，归去，也无风雨也无晴"}, {"t0": 464.491, "t1": 466.517, "text": "他没有说雨不存在"}, {"t0": 466.567, "t1": 469.891, "text": "他说的是：风雨来过，晴天也会来"}, {"t0": 469.941, "t1": 473.405, "text": "而我，不必跟着天气一起翻覆"}, {"t0": 473.755, "t1": 476.789, "text": "这份从容不是一开始就有的"}, {"t0": 476.839, "t1": 481.414, "text": "是孤鸿和死灰，是寒菜和湿苇，是开荒的锄头"}, {"t0": 481.464, "t1": 483.984, "text": "梁上的铜钱、赤壁的一夜"}, {"t0": 484.034, "t1": 486.44, "text": "一点一点，换回来的"}, {"t0": 488.69, "t1": 493.542, "text": "如果你此刻也在低谷：允许自己难过，把它写下来"}, {"t0": 493.592, "t1": 496.728, "text": "然后，去做一件小小的、具体的事"}, {"t0": 496.778, "t1": 499.579, "text": "再试着，把镜头拉远一点"}, {"t0": 500.129, "t1": 504.065, "text": "如果低落持续了很久，已经影响到吃饭和睡觉"}, {"t0": 504.115, "t1": 507.632, "text": "也请记得去找身边的人，去找专业的帮助"}, {"t0": 507.682, "t1": 509.501, "text": "这一点也不丢人"}, {"t0": 510.051, "t1": 511.409, "text": "情绪是一场雨"}, {"t0": 511.459, "t1": 514.626, "text": "你可以被淋湿，但不必被冲走"}]